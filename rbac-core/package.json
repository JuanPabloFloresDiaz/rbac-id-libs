{
  "name": "@oscardevpr/rbac-core",
  "version": "1.0.2",
  "description": "Framework-agnostic RBAC core — permission engine, config, HTTP and seeder",
  "type": "module",
  "main": "./dist/rbac-core.umd.cjs",
  "module": "./dist/rbac-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rbac-core.js",
      "require": "./dist/rbac-core.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "typescript": "^5.4.0",
    "vite-plugin-dts": "^3.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OsCARdevPr/rbac-vue.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
