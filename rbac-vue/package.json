{
  "name": "@oscardevpr/rbac-vue",
  "version": "1.0.2",
  "description": "RBAC library for Vue 3 + Pinia applications",
  "type": "module",
  "main": "./dist/rbac-vue.umd.cjs",
  "module": "./dist/rbac-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rbac-vue.js",
      "require": "./dist/rbac-vue.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "pinia": "^2.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "vue": "^3.4.21",
    "pinia": "^2.1.7",
    "vue-router": "^4.3.0",
    "@oscardevpr/rbac-core": "workspace:*",
    "vite": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "vitest": "^1.0.0",
    "typescript": "^5.4.0",
    "vite-plugin-dts": "^3.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OsCARdevPr/rbac-vue.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
